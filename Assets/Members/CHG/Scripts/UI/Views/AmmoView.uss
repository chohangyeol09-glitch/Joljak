.ammo-hud {
    flex-direction: row;
    align-items: flex-end;
    padding-top: 6px;
    padding-right: 14px;
    padding-bottom: 16px;
    padding-left: 14px;
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.ammo-icon {
    width: 54px;
    height: 54px;
    flex-shrink: 0; 
    margin-right: 10px;
    margin-bottom: 2px;
}

.ammo-icon__img {
    position: absolute;
    top: 0;
    left: 0;
    width: 54px;
    height: 54px;
}

.ammo-icon__clip {
    position: absolute;
    top: 0;
    left: 0; 
    height: 100%;
    width: 100%; 
    overflow: hidden; 
}


.ammo-reload-track {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 5px;
    height: 5px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    overflow: hidden; 
    display: none; 
}

.ammo-reload-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0; 
    background-color: rgb(255, 205, 80);
}


.ammo__count {
    color: rgb(255, 255, 255);
    font-size: 30px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.ammo__count--max {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 3px;
}

.ammo__sep {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.5);
    -unity-font-style: bold;
    margin-left: 3px;
    margin-right: 3px;
    margin-bottom: 2px;
}
