<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Members/CWH/UI/BossHealthBarUI.uss?fileID=7433441132597879392&amp;guid=8d9d56a6f6cb0d542aa86cc160992cba&amp;type=3#BossHealthBarUI"/>
    <ui:VisualElement name="HealthContainer" style="position: absolute; top: 8px; width: 520px; left: 50%; translate: -50% 0; right: auto; height: 130px; padding-top: 3px; padding-right: 13px; padding-bottom: 3px; padding-left: 13px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px;">
        <ui:VisualElement name="BossTextBox" style="flex-direction: row; justify-content: center;">
            <ui:Label text="[BOSS]" name="MonsterTagText" style="font-size: 16px; -unity-font-style: bold; color: rgb(135, 0, 0);"/>
            <ui:Label text="여기에 보스이름" name="BossNameText" style="-unity-text-align: middle-right; color: rgb(255, 255, 60); font-size: 16px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="BaroutLine" style="flex-basis: 20px; background-color: rgb(67, 67, 67); justify-content: center; padding-right: 6px; padding-left: 6px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;">
            <ui:VisualElement name="BarTrack" style="background-color: rgb(0, 0, 0); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; flex-basis: 11px;">
                <ui:VisualElement name="SlowBarFill" style="position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(112, 0, 0); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; width: 100%;"/>
                <ui:VisualElement name="RealBarFill" style="position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(192, 0, 0); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; width: 100%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="HealthPercent" style="flex-grow: 1; align-items: flex-start; justify-content: flex-start; flex-direction: column; flex-wrap: wrap-reverse;">
            <ui:Label text="100%" name="HealthPercentText" style="font-size: 13px; -unity-font-style: bold; color: rgb(0, 0, 0); -unity-text-align: upper-left;"/>
        </ui:VisualElement>
        <ui:VisualElement name="PhaseRow" style="flex-direction: row; justify-content: center; margin-top: 3px; margin-bottom: 3px; display: none;">
            <ui:Label text="PHASE 1" name="Phase0" class="phase-chip phase-chip--active"/>
            <ui:Label text="PHASE 2" name="Phase1" class="phase-chip"/>
            <ui:Label text="PHASE 3" name="Phase2" class="phase-chip"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
